{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "API: Debug server.js",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Tests: Debug all Jest tests",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "npm",
            "runtimeArgs": ["test", "--", "--runInBand"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Tests: Debug current file (Jest)",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "npx",
            "runtimeArgs": ["jest", "${fileBasenameNoExtension}", "--runInBand"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Tools: Generate Swagger",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/swagger.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "API + Swagger (sequential)",
            "configurations": ["Tools: Generate Swagger", "API: Debug server.js"],
            "stopAll": true
        }
    ]
}